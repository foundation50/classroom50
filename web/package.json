{
  "name": "classroom-alpha",
  "private": true,
  "version": "1.48.2",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "arch:validate": "depcruise src --config .dependency-cruiser.cjs",
    "audit:contrast": "npx vite-node scripts/a11y/genContrastAudit.ts",
    "audit:vpat": "npx vite-node scripts/a11y/genVpatReport.ts",
    "audit:a11y": "vitest run src/test/axe.test.tsx src/test/a11yStructural.test.tsx src/util/a11y/vpatAutomated.test.ts",
    "audit:a11y:inventory": "npx vite-node scripts/a11y/genA11yInventory.ts",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -b && eslint . && prettier --check . && npm run arch:validate && vitest run",
    "preview": "vite preview --configLoader native",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "missing": "tsc -p tsconfig.app.json --pretty false 2>&1 | grep -E \"TS(2304|2305|2307|2503|2552)\""
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@primer/octicons-react": "^19.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "canvas-confetti": "^1.9.4",
    "i18next": "^26.4.2",
    "jszip": "^3.10.2",
    "libsodium-wrappers": "^0.8.4",
    "motion": "^12.43.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.7.32",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "~20.11.15",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "brace-expansion": "^5.0.8"
  }
}
